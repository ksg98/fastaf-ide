{"step":"respond","to":"init","result_file":"ego-initialize.json"}
{"step":"expect","method":"session/new","capture":"new"}
{"step":"respond","to":"new","result":{"sessionId":"01932d5e-0000-7000-8000-0000000000aa","configOptions":[]}}
{"step":"expect","method":"session/prompt","capture":"prompt"}
{"step":"request","id":7,"method":"session/request_permission","params":{"sessionId":"01932d5e-0000-7000-8000-0000000000aa","toolCall":{"toolCallId":"call-1","title":"Write a file"},"options":[{"optionId":"allow","name":"Allow","kind":"allow_once"}]}}
{"step":"request","id":8,"method":"elicitation/create","params":{"sessionId":"01932d5e-0000-7000-8000-0000000000aa","mode":"form","message":"Which branch?","requestedSchema":{"type":"object","properties":{"branch":{"type":"string","title":"Branch"}},"required":["branch"]}}}
