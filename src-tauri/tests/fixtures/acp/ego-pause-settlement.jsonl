// ego answers a pending hold, then uses its documented -32011 pause code.
{"step":"expect","method":"initialize","params":{"protocolVersion":1},"capture":"init"}
{"step":"respond","to":"init","result_file":"ego-initialize.json"}
{"step":"expect","method":"session/new","capture":"new"}
{"step":"respond","to":"new","result":{"sessionId":"01932d5e-0000-7000-8000-0000000000aa","configOptions":[]}}
{"step":"expect","method":"session/prompt","capture":"prompt"}
{"step":"expect","method":"_ego/pause","capture":"pause"}
{"step":"respond","to":"pause","result":{"v":1,"sessionId":"01932d5e-0000-7000-8000-0000000000aa","requestId":"01932d5e-0000-7000-8000-0000000000f1","state":"pending"}}
{"step":"error","to":"prompt","code":-32011,"message":"session held at a boundary"}
{"step":"expect","method":"_ego/resume","capture":"resume"}
{"step":"respond","to":"resume","result":{"v":1,"sessionId":"01932d5e-0000-7000-8000-0000000000aa","requestId":"01932d5e-0000-7000-8000-0000000000f1","state":"running"}}
{"step":"expect","method":"session/prompt","capture":"next_prompt"}
{"step":"respond","to":"next_prompt","result":{"stopReason":"end_turn"}}
{"step":"await_stdin_eof"}
