{"step":"respond","to":"new","result":{"sessionId":"01932d5e-0000-7000-8000-0000000000aa","configOptions":[]}}
{"step":"expect","method":"session/prompt","params":{"sessionId":"01932d5e-0000-7000-8000-0000000000aa","prompt":[{"type":"text","text":"desktop"}]},"capture":"desktop"}
{"step":"expect","method":"session/list","capture":"barrier"}
