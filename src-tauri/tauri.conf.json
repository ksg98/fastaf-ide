{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FastAF",
  "mainBinaryName": "FastAF",
  "version": "2.2.1",
  "identifier": "com.fastaf.ide",
  "build": {
    "features": [
      "dictation"
    ],
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1421",
    "beforeBuildCommand": "pnpm build && pnpm build:sidecar",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "FastAF",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "decorations": true,
        "transparent": false,
        "resizable": true,
        "fullscreen": false,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": {
          "x": 13,
          "y": 20
        },
        "backgroundColor": "#141414",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' https: http: ws: wss: data: blob: asset: http://asset.localhost ipc: tauri: plugin:",
      "dangerousDisableAssetCspModification": [
        "style-src",
        "script-src"
      ],
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$APPDATA/**/*",
          "$HOME/**",
          "/**",
          "$HOME/Gits/**/.tmp/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "FastAF",
    "homepage": "https://github.com/ksg98/fastaf-ide",
    "copyright": "Copyright 2026 The FastAF authors",
    "license": "Apache-2.0",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "icons/32x32.png": "icons/32x32.png",
      "icons/drag-file.png": "icons/drag-file.png",
      "../LICENSE": "licenses/LICENSE",
      "../NOTICE": "licenses/NOTICE",
      "../THIRD_PARTY_NOTICES.md": "licenses/THIRD_PARTY_NOTICES.md"
    },
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/tuic-bridge",
      "binaries/fastaf-cli"
    ],
    "fileAssociations": [
      {
        "ext": [
          "md",
          "mdx"
        ],
        "name": "Markdown Document",
        "role": "Viewer",
        "mimeType": "text/markdown"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": "./Entitlements.plist"
    },
    "linux": {
      "deb": {
        "depends": [
          "libayatana-appindicator3-1"
        ]
      },
      "rpm": {
        "depends": [
          "libayatana-appindicator-gtk3"
        ]
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "tuic"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU1QkY0MDJERTBERTQyRTkKUldUcFF0N2dMVUMvNVExSXNvUE9uejJIaEx4dUJMLzNEKzU3MEQzTXhwU3JndVNHa1Y5SXFvSU0K",
      "endpoints": [
        "https://github.com/ksg98/fastaf-ide/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
